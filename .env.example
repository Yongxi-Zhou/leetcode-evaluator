# LeetCode Credentials
# Get these from your browser after logging in:
# 1. Login to leetcode.com in your browser
# 2. Open DevTools (F12) -> Application -> Cookies -> leetcode.com
# 3. Copy LEETCODE_SESSION and csrftoken values
LEETCODE_SESSION_COOKIE=your_key
LEETCODE_CSRF_TOKEN=your_leetcode-token
# LLM Provider Selection
# Options: bedrock, openai, gemini, grok
# LLM_PROVIDER=bedrock

# AWS Bedrock Configuration (if using bedrock provider)

# Option 2: Use Explicit Access Keys (Fallback)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Bedrock Model Selection
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0


# OpenAI Configuration (if using openai provider)
# OPENAI_API_KEY=your_key
# OPENAI_MODEL_ID=gpt-4.1-nano

# Google Gemini Configuration (if using gemini provider)
# GEMINI_API_KEY=your_key
# GEMINI_MODEL_ID=gemini-2.5-pro-preview-03-25

# xAI Grok Configuration (if using grok provider)
# GROK_API_KEY=your_grok_api_key
# GROK_MODEL_ID=grok-beta
# GROK_API_BASE_URL=https://api.x.ai/v1
