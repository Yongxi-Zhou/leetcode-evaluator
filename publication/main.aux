\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cross-model stability heatmap (\textsc  {Detailed} prompt). Rows: 16 models sorted by RLPR descending. Columns: 100 problems grouped by difficulty tier with dashed separators, and ordered within each tier by decreasing mean pass rate. Cell color encodes empirical pass rate over $R=5$ runs (green $=1.0$, red $=0.0$, yellow $\approx 0.5$).}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stability-heatmap}{{2}{7}{Cross-model stability heatmap (\textsc {Detailed} prompt). Rows: 16 models sorted by RLPR descending. Columns: 100 problems grouped by difficulty tier with dashed separators, and ordered within each tier by decreasing mean pass rate. Cell color encodes empirical pass rate over $R=5$ runs (green $=1.0$, red $=0.0$, yellow $\approx 0.5$)}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Problem-level success distribution (\textsc  {Detailed} prompt). The figure contains one panel per model (16 panels total), arranged in decreasing order of PSR. Each panel shows the fraction of that model's 100 problems falling in each empirical pass-probability bin $\hat  {p}_i \in \{0/5, 1/5, \ldots  , 5/5\}$, where $0/5$ means the model failed all 5 runs and $5/5$ means it passed all 5.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:success-distribution}{{3}{7}{Problem-level success distribution (\textsc {Detailed} prompt). The figure contains one panel per model (16 panels total), arranged in decreasing order of PSR. Each panel shows the fraction of that model's 100 problems falling in each empirical pass-probability bin $\hat {p}_i \in \{0/5, 1/5, \ldots , 5/5\}$, where $0/5$ means the model failed all 5 runs and $5/5$ means it passed all 5}{figure.caption.12}{}}
